{
  "compilerOptions": {
    "target": "ES2024", "module": "Node16", "moduleResolution": "Node16", "lib": ["ES2024", "DOM"],
    "strict": true, "erasableSyntaxOnly": true, "verbatimModuleSyntax": true, "esModuleInterop": true,
    "skipLibCheck": true, "forceConsistentCasingInFileNames": true, "declaration": true,
    "declarationMap": true, "sourceMap": true, "inlineSources": true,
    "allowImportingTsExtensions": true, "rewriteRelativeImportExtensions": true,
    "types": ["node"], "rootDir": "src", "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
