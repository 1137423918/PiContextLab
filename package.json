{
  "name": "pi-metriclab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-based retail metric investigations built on the Pi agent runtime",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc --noEmit -p vendor/pi-agent-core/tsconfig.json && tsc --noEmit",
    "build": "npm run build:core && tsc",
    "test": "node --test --test-concurrency=1 dist/test/*.test.js",
    "start": "node dist/src/cli.js serve",
    "ingest": "node dist/src/cli.js ingest",
    "build:core": "tsc -p vendor/pi-agent-core/tsconfig.json"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.1-r.1",
    "@earendil-works/pi-agent-core": "file:vendor/pi-agent-core",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-schema": "1.6.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "7.0.2",
    "@pi-context-lab/upstream-agent-core": "npm:@earendil-works/pi-agent-core@1.6.0"
  }
}
